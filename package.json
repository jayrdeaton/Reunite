{
  "name": "reunite",
  "version": "1.3.8",
  "description": "Tile app windows into a saved grid layout",
  "keywords": [
    "cli",
    "display",
    "grid",
    "layout",
    "linux",
    "mac",
    "macos",
    "tile",
    "tiling",
    "window-manager",
    "windows",
    "workspace",
    "x11"
  ],
  "homepage": "https://github.com/jayrdeaton/Reunite#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/Reunite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/Reunite.git"
  },
  "license": "ISC",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": "./bin/cli.mjs"
  },
  "bin": {
    "reunite": "./bin/cli.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:patch": "npm version patch && git push --follow-tags",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "cosmetic": "^1.1.1",
    "termkit": "^1.2.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-package-json": "^1.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
